{
  "name": "gokturkce-kursu",
  "private": true,
  "type": "module",
  "description": "Göktürkçe Okuma-Yazma Öğreneği — tek içerik kaynağı (content/*.json), tek JS motor (engine/), üç hedef (baski-pdf | slayt-html | slayt-pdf)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "tema:uygula": "node engine/tema-uygula.mjs",
    "tema:rapor": "node engine/tema-uygula.mjs --rapor",
    "denetim:uygula": "node engine/denetim-uygula.mjs --son",
    "tekin98:tara": "node engine/tekin1998-tara.mjs",
    "kaynak:tara": "node engine/kaynak-tara.mjs",
    "ceviri:blok": "node engine/ceviri-blok-uret.mjs",
    "ceviri:birlestir": "node engine/ceviri-blok-birlestir.mjs",
    "cumlecik:ayir": "node engine/cumlecik-ayir.mjs",
    "ceviri:liste": "node engine/ceviri-istek-listesi.mjs",
    "icerik:uret": "node engine/icerik-uret.mjs",
    "icerik:kontrol": "node engine/icerik-uret.mjs && git diff --exit-code --stat src/data/generated"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.4.0",
    "lucide-react": "^1.46.0",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
