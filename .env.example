# Server & Applet Configuration
PORT=3000
KOK=build/paket

# Optional: Sınav sonuçları sunucusu ayarları
SONUC_TOKEN=
SONUC_DIR=
GK_SONUC_URL=
GK_EPOSTA=
GK_BROWSER=

# AI Studio Capability
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Firebase (hesap + bulut ilerleme) — İSTEĞE BAĞLI
# Boş bırakılırsa uygulama hesapsız, tamamen yerel çalışır.
# Değerler Firebase Console > Proje Ayarları > Web uygulaması'ndan alınır.
# VITE_ önekli değişkenler istemci paketine girer; bunlar gizli anahtar
# DEĞİLDİR, erişimi Firestore güvenlik kuralları belirler.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIza...            # firebase apps:sdkconfig web
VITE_FIREBASE_AUTH_DOMAIN=<proje>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<proje-kimligi>
VITE_FIREBASE_APP_ID=1:<numara>:web:<id>
VITE_FIREBASE_STORAGE_BUCKET=<proje>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<numara>
# Gerçek değerler .env.local dosyasına yazılır (gitignore'da).

# ─────────────────────────────────────────────────────────────
# Kapalı tanıtım (demo) ayarları
# ─────────────────────────────────────────────────────────────
# Erişim kodu. Doluysa uygulama açılmadan önce kod sorulur.
# Boş bırakılırsa kapı hiç çıkmaz (herkese açık sürüm).
# NOT: Bu bir görünürlük kapısıdır, güvenlik duvarı değildir —
# içerik yine de JS paketinin içindedir.
VITE_DEMO_KODU=

# Denetim (admin) ekranı üretim derlemesine girsin mi: acik | boş
# "acik" ise yayındaki uygulamada #denetim adresiyle açılır.
VITE_DENETIM=
