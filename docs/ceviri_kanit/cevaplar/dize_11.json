{
 "cevaplar": [
  {
   "id": "TY1-K-2#2",
   "gunumuzTurkcesi": "Yuvarlanarak indik. On gecede yandaki engeli dolanarak gittik.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-2#3",
   "gunumuzTurkcesi": "Kılavuz yanıldı ve boğazlandı.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-2#4",
   "gunumuzTurkcesi": "Sıkılıp kağan \"Sürün atları!\" demiş.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-4#1",
   "gunumuzTurkcesi": "(Uykularını) mızraklarımızla açtık. (Bu arada) hanları ve orduları toparlanmış.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-4#2",
   "gunumuzTurkcesi": "Savaştık, mızrakladık. Hanlarını öldürdük.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-4#3",
   "gunumuzTurkcesi": "Kırgız halkı kağana teslim oldu.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-4#4",
   "gunumuzTurkcesi": "Boyun eğdi. Döndük; Kögmen dağlarını dolanıp geldik.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-5#1",
   "gunumuzTurkcesi": "Kırgızlardan döndük. (Bu arada) Türgiş kağanından kaçak geldi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-5#2",
   "gunumuzTurkcesi": "Sözleri şöyle idi: \"Doğu kağanına karşı sefer edelim\" demiş.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-5#3",
   "gunumuzTurkcesi": "\"Sefer etmezsek, bizi — kağanı cesur imiş,",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-5#4",
   "gunumuzTurkcesi": "sözcüsü akıllı imiş —",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-5#5",
   "gunumuzTurkcesi": "ne zaman olsa",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-6#1",
   "gunumuzTurkcesi": "bizi mutlak öldürecektir\" demiş.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-6#2",
   "gunumuzTurkcesi": "(Kaçak er) \"Türgiş kağanı sefere çıkmış\"",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-6#3",
   "gunumuzTurkcesi": "dedi, \"On-Ok halkı",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-6#4",
   "gunumuzTurkcesi": "tümüyle sefere çıkmış diyorlar; (içlerinde) Çin askerleri (de) var imiş.\"",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-6#5",
   "gunumuzTurkcesi": "Bu sözleri işitip kağanım \"Ben karargaha ineyim\" dedi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-7#1",
   "gunumuzTurkcesi": "Hatun yok olmuş",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-7#2",
   "gunumuzTurkcesi": "idi. \"Onun cenaze törenini yaptırayım\" dedi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-7#3",
   "gunumuzTurkcesi": "\"Ordu, (siz) gidin\" dedi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-7#4",
   "gunumuzTurkcesi": "\"Altay dağlarında oturun\"",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-7#5",
   "gunumuzTurkcesi": "dedi. \"Kumandan (olarak) İnel Kağan ile Tarduşların Şadı görev yapsınlar!\" dedi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-7#6",
   "gunumuzTurkcesi": "Bilge Tonyukuk'a, bana dedi (ki):",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-8#1",
   "gunumuzTurkcesi": "\"Bu orduyu sevk et\" dedi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-8#2",
   "gunumuzTurkcesi": "\"(Suç işleyenlerin) cezalarını dilediğin gibi ver. Ben sana (daha) ne diyeyim?\" dedi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-8#3",
   "gunumuzTurkcesi": "\"(Düşman) gelir ise görülüp",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-8#4",
   "gunumuzTurkcesi": "gelir; gelmez ise haberlerini alarak oturun!\"",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-8#5",
   "gunumuzTurkcesi": "dedi. Altay dağlarında oturduk.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-9#1",
   "gunumuzTurkcesi": "Üç kaçak kişi geldi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-9#2",
   "gunumuzTurkcesi": "Sözleri bir (idi): \"Kağanları orduyla sefere çıktı.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-9#3",
   "gunumuzTurkcesi": "On-Ok ordusu tümüyle sefere çıktı",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-9#4",
   "gunumuzTurkcesi": "diyorlar. Yarış ovasında toplanalım!\" demiş.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-9#5",
   "gunumuzTurkcesi": "Bu sözleri işitip kağana bu haberi gönderdim.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-9#6",
   "gunumuzTurkcesi": "Kağan tarafından yanıtı",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY2-B-1#1",
   "gunumuzTurkcesi": "(Bu arada bir) haberci getirdiler. Sözleri şöyle: \"Yarış ovasında yüz bin asker toplandı\"",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-1#2",
   "gunumuzTurkcesi": "diyor. Bu haberi duyunca beyler hep birlikte",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-2#1",
   "gunumuzTurkcesi": "\"Dönelim; temizin utancı",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-2#2",
   "gunumuzTurkcesi": "daha iyidir!\" dediler. Ben de şöyle dedim — ben Bilge Tonyukuk şöyle diyorum. Altay dağlarını aşarak geldik.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-2#3",
   "gunumuzTurkcesi": "İrtiş ırmağını",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-3#1",
   "gunumuzTurkcesi": "geçerek geldik. (Buralara kadar) gelenler \"(Geliş) zordu!\" dediler.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-3#2",
   "gunumuzTurkcesi": "(Ama pek de zorluk) hissetmediler. Galiba Tanrı Umay, kutsal Yer ve Su (ruhları bize) yardımcı oluverdiler.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-3#3",
   "gunumuzTurkcesi": "Niye kaçıyoruz?",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-4#1",
   "gunumuzTurkcesi": "(Düşman) çok diye niye korkuyoruz?",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-4#2",
   "gunumuzTurkcesi": "Azız diye niye yenilelim? Saldıralım!\" dedim.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-4#3",
   "gunumuzTurkcesi": "Saldırdık, talan ettik. İkinci gün (daha da) çok geldiler.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-5#1",
   "gunumuzTurkcesi": "Ateş gibi kızıp (üzerimize) geldiler.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-5#2",
   "gunumuzTurkcesi": "Savaştık. (Onların) iki kanadı bizden yarı yarıya fazla idi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-5#3",
   "gunumuzTurkcesi": "Tanrı buyurduğu için, (düşman) çok diye biz",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-7#1",
   "gunumuzTurkcesi": "orada öldürdük. Elli kadar asker yakaladık.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-7#2",
   "gunumuzTurkcesi": "O gece hepsinin halkına (bunlarla haber) gönderdik.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-7#3",
   "gunumuzTurkcesi": "O haberi alınca On-Ok beyleri ve halkı hep",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-8#1",
   "gunumuzTurkcesi": "geldiler, boyun eğdiler. (Bize) gelen beylerini ve halkını derleyip topladım; bir az halk kaçıp gitmiş",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-8#2",
   "gunumuzTurkcesi": "idi. On-Ok ordusunu sefere çıkarttım.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-G-1#1",
   "gunumuzTurkcesi": "Demir Kapı'ya kadar eriştik.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  }
 ]
}