{"cevaplar": [
{"id": "BK-K-12#1", "gunumuzTurkcesi": "gök sincaplarını Türklerime ve halkıma kazanıverdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},

{"id": "BK-K-13#1", "gunumuzTurkcesi": "Yine (iyi) besleyin; eza (ve) cefa etmeyin.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},

{"id": "BK-K-14#1", "gunumuzTurkcesi": "İyilik göreceksin, evine gireceksin (ve) dertsiz olacaksın. Ondan sonra Çin imparatorundan (pek) çok sanatçı getirttim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},
{"id": "BK-K-14#2", "gunumuzTurkcesi": "(Çin kağanı) benim sözümü kırmadı.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},
{"id": "BK-K-14#3", "gunumuzTurkcesi": "(Kendi) saray sanatkârlarını gönderdi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},
{"id": "BK-K-14#4", "gunumuzTurkcesi": "Onlara olağanüstü (bir) tapınak yaptırttım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},
{"id": "BK-K-14#5", "gunumuzTurkcesi": "İçini (ve) dışını olağanüstü resim ve heykellerle süslettim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},
{"id": "BK-K-14#6", "gunumuzTurkcesi": "(Ebedi) taş kazdırttım, (üzerine) gönlümdeki sözlerimi hâkkettirdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},

{"id": "BK-K-15#1", "gunumuzTurkcesi": "On-Ok oğullarına (ve onlara tabi) yabancılara kadar (hepiniz) bunu görün (ve) öğrenin.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},
{"id": "BK-K-15#2", "gunumuzTurkcesi": "Ebedi taş hâkkettirdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 32"},

{"id": "BK-B-2#1", "gunumuzTurkcesi": "Bilge Kağan vefat etti.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 42"},

{"id": "BK-B-7#1", "gunumuzTurkcesi": "(Mezar) taşını bizzat (ben) kağan", "tur": "ceviri", "kaynak": "Tekin 1998, s. 42"},

{"id": "TY1-B-1#1", "gunumuzTurkcesi": "Bilge Tonyukuk, ben kendim, Çin yönetimi sırasında doğdum.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-1#2", "gunumuzTurkcesi": "Türk halkı (o zaman) Çin'e bağımlı idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},

{"id": "TY1-B-2#1", "gunumuzTurkcesi": "Türk halkı, (kendi) hanını bulmayınca Çin'den ayrıldı.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-2#2", "gunumuzTurkcesi": "Han sahibi oldu; (fakat) hanını bırakıp Çin'e yeniden bağımlı oldu.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-2#3", "gunumuzTurkcesi": "Tanrı şöyle demiş", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-2#4", "gunumuzTurkcesi": "olmalı: \"(Sana) han verdim,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},

{"id": "TY1-B-3#1", "gunumuzTurkcesi": "hanını bırakıp (yine) bağımlı oldun.\"", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-3#2", "gunumuzTurkcesi": "(Türk halkı yeniden) bağımlı olduğu için Tanrı \"Öl!\" demiş", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-3#3", "gunumuzTurkcesi": "olmalı. Türk halkı öldü.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-3#4", "gunumuzTurkcesi": "Mahvoldu, yok oldu.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-3#5", "gunumuzTurkcesi": "Türk Sir halkı(nın) ülkesinde", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},

{"id": "TY1-B-4#1", "gunumuzTurkcesi": "boy kalmadı. Dağda bayırda kalmış olanlar toplanıp yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-4#2", "gunumuzTurkcesi": "yüz (kişi) oldu. (Bunların) iki bölüğü atlı idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-4#3", "gunumuzTurkcesi": "Bir bölüğü yaya idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-4#4", "gunumuzTurkcesi": "Yedi yüz kişiyi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},

{"id": "TY1-B-5#1", "gunumuzTurkcesi": "sevk eden üstleri \"Şad\" idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-5#2", "gunumuzTurkcesi": "\"Sözcüm ol!\" dedi; sözcüsü ben idim,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-5#3", "gunumuzTurkcesi": "Bilge Tonyukuk. \"(Bunu) kağan mı yapayım?\" dedim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-5#4", "gunumuzTurkcesi": "Düşündüm: (İnsan) zayıf boğalarla semiz boğaları uzaktan", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},

{"id": "TY1-B-6#1", "gunumuzTurkcesi": "bilmek zorunda kalsa, hangilerinin semiz boğa, hangilerinin zayıf boğa olduğunu bilmez imiş", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-6#2", "gunumuzTurkcesi": "diye öylece düşündüm.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-6#3", "gunumuzTurkcesi": "Ondan sonra, Tanrı akıl verdiği için, (onu) ben kendim kağan yaptım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-6#4", "gunumuzTurkcesi": "Bilge Tonyukuk Buyla Bağa Tarkan", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},

{"id": "TY1-B-7#1", "gunumuzTurkcesi": "sayesinde İlteriş kağan olarak güneyde Çinlileri, doğuda Kıtayları, kuzeyde Oğuzları pek çok öldürdü.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-7#2", "gunumuzTurkcesi": "Danışmanı (ve) kumandanı ben idim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},
{"id": "TY1-B-7#3", "gunumuzTurkcesi": "Çuğay'ın kuzeyinde, Kara Kumug'da oturur idik.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 43"},

{"id": "TY1-G-1#1", "gunumuzTurkcesi": "Yaban hayvanları yiyerek, tavşan yiyerek yaşıyor", "tur": "ceviri", "kaynak": "Tekin 1998, s. 44"},
{"id": "TY1-G-1#2", "gunumuzTurkcesi": "idik. Halkın boğazı tok idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 44"},
{"id": "TY1-G-1#3", "gunumuzTurkcesi": "Düşmanlarımız çepeçevre ocak gibi idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 44"},
{"id": "TY1-G-1#4", "gunumuzTurkcesi": "Biz (ortadaki) aş gibi idik.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 44"},
{"id": "TY1-G-1#5", "gunumuzTurkcesi": "Böylece oturur iken Oğuzlardan bir kaçak geldi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 44"}
]}
