{"cevaplar": [
{"id": "TY2-G-2#1", "gunumuzTurkcesi": "ve onların berisindeki Aşok başlı Soğdak halkı hep geldiler, boyun eğdiler.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-2#2", "gunumuzTurkcesi": "O gün erişti. Türk halkının Demir Kapı'ya, \"Tanrı Oğlu\"", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-G-3#1", "gunumuzTurkcesi": "\"Tanrı Oğlu\" denilen dağlara (kadar) vardığı", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-3#2", "gunumuzTurkcesi": "hiç yok imiş.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-G-4#1", "gunumuzTurkcesi": "Kızıl altınları, beyaz", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-4#2", "gunumuzTurkcesi": "gümüşleri, kızları kadınları, hörgüçlü develeri ve ipekli kumaşları fazlasıyla (önümüze) getirdiler.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-4#3", "gunumuzTurkcesi": "İlteriş Kağan akıllı olduğu için,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-G-5#1", "gunumuzTurkcesi": "devleti için Çinlilerle yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-5#2", "gunumuzTurkcesi": "on yedi (kez) savaştı; Kıtaylarla yedi (kez)", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-5#3", "gunumuzTurkcesi": "savaştı; Oğuzlarla (da) beş (kez) savaştı. Bu sırada sözcüsü", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-G-6#1", "gunumuzTurkcesi": "yine ben idim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-6#2", "gunumuzTurkcesi": "Akıl veren (danışmanı) da yine ben idim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-6#3", "gunumuzTurkcesi": "İlteriş Kağan vefat etti.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-G-6#4", "gunumuzTurkcesi": "Türk Bögü Kağana, Türk Bilge Kağana", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-D-1#1", "gunumuzTurkcesi": "Kapgan Kağan yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-1#3", "gunumuzTurkcesi": "(Onu) Kapgan Kağan (olarak) tahta oturttum. Geceleri uyumadan,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-D-2#1", "gunumuzTurkcesi": "gündüzleri oturmadan, kızıl kanımı akıtarak,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-2#2", "gunumuzTurkcesi": "kara terimi döktürerek", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-2#3", "gunumuzTurkcesi": "hizmet ettim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-2#4", "gunumuzTurkcesi": "Uzak mesafelere keşif devriyeleri gönderdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-D-4#1", "gunumuzTurkcesi": "Bu Türk halkı içinde zırhlı düşmanların akınına imkân vermedim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-4#2", "gunumuzTurkcesi": "(Kuyruğu) düğümlü (düşman) atlarını koşturtmadım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-4#3", "gunumuzTurkcesi": "İlteriş Kağan kazanmasa (idi),", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-D-5#1", "gunumuzTurkcesi": "ve ben kendim kazanmasa (idim) devlet de halk da olmayacak idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-5#2", "gunumuzTurkcesi": "(Kağan) kazandığı için ve ben kendim kazandığım için,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-D-6#1", "gunumuzTurkcesi": "devlet de devlet oldu.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-6#2", "gunumuzTurkcesi": "Halk da halk oldu.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-6#3", "gunumuzTurkcesi": "(Şimdi) ben kocaldım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},
{"id": "TY2-D-6#4", "gunumuzTurkcesi": "Yaşlı oldum. Herhangi bir ülkedeki kağanlı (bağımsız) bir halkın", "tur": "ceviri", "kaynak": "Tekin 1998, s. 48"},

{"id": "TY2-D-8#2", "gunumuzTurkcesi": "Ben Bilge Tonyukuk.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 49"},

{"id": "TY2-K-1#1", "gunumuzTurkcesi": "İlteriş Kağan kazanmasa (idi), (ya da hiç) olmasa", "tur": "ceviri", "kaynak": "Tekin 1998, s. 49"},
{"id": "TY2-K-1#2", "gunumuzTurkcesi": "idi, ben kendim Bilge Tonyukuk kazanmasa (idim), (ya da) ben hiç olmasa idim,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 49"},

{"id": "TY2-K-2#1", "gunumuzTurkcesi": "Kapgan Kağan('ın) Türk Sir halkı ülkesinde boy da, halk da, insan da hiç", "tur": "ceviri", "kaynak": "Tekin 1998, s. 49"},
{"id": "TY2-K-2#2", "gunumuzTurkcesi": "olmayacak idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 49"},

{"id": "TY2-K-3#1", "gunumuzTurkcesi": "İlteriş Kağan (ve) Bilge Tonyukuk kazandığı için Kapgan Kağan'ın (ve) Türk Sir halkının gelişmesi (işte) budur.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 49"}
]}
