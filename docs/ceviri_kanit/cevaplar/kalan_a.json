{"cevaplar": [
{"id": "KT-G-5#1", "gunumuzTurkcesi": "(İlişkileri) düzelttim. (Çinliler) altını, gümüşü,", "tur": "ceviri", "kaynak": "Tekin 1998, s. 20"},
{"id": "KT-G-5#2", "gunumuzTurkcesi": "ipeği (ve) ipekli kumaşları güçlük çıkarmaksızın öylece (bize) veriyorlar.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 20"},
{"id": "KT-G-5#3", "gunumuzTurkcesi": "Çin halkının sözleri tatlı, ipekli kumaşları yumuşak imiş.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 20"},
{"id": "KT-G-5#4", "gunumuzTurkcesi": "Tatlı sözlerle, yumuşak ipekli kumaşlarla kandırıp uzak(larda yaşayan) halkları öylece (kendilerine) yaklaştırırlar imiş.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 20"},
{"id": "KT-G-5#5", "gunumuzTurkcesi": "Yaklaşıp yerleştikten sonra kötü niyetlerini o zaman düşünürler imiş.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 20"},

{"id": "KT-D-15#1", "gunumuzTurkcesi": "Kırk yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 23"},
{"id": "KT-D-15#2", "gunumuzTurkcesi": "kez sefer etmiş, yirmi (kez) savaşmış.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 23"},
{"id": "KT-D-15#3", "gunumuzTurkcesi": "Tanrı (öyle) buyurduğu için, devletliyi devletsiz bırakmış.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 23"},
{"id": "KT-D-15#4", "gunumuzTurkcesi": "Kağanlıyı kağansız bırakmış, düşmanları bağımlı kılmış.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 23"},
{"id": "KT-D-15#5", "gunumuzTurkcesi": "Dizlilere diz çöktürmüş, başlılara baş eğdirmiş.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 23"},
{"id": "KT-D-15#6", "gunumuzTurkcesi": "Babam kağan, öylece devleti", "tur": "ceviri", "kaynak": "Tekin 1998, s. 23"},

{"id": "KT-D-35#1", "gunumuzTurkcesi": "yaşında (iken) Kırgızlara doğru sefer ettik.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 26"},
{"id": "KT-D-35#2", "gunumuzTurkcesi": "Mızrak batımı karı söküp Kögmen dağlarını aşarak Kırgız halkını uykuda (iken) bastık.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 26"},
{"id": "KT-D-35#3", "gunumuzTurkcesi": "Kağanları ile Songa dağında savaştık.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 26"},
{"id": "KT-D-35#4", "gunumuzTurkcesi": "Kül Tigin Bayırkuların ak aygırına", "tur": "ceviri", "kaynak": "Tekin 1998, s. 26"},

{"id": "KT-K-1#2", "gunumuzTurkcesi": "Adamlarını hep öldürmüş.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 27"},
{"id": "KT-K-1#3", "gunumuzTurkcesi": "Evlerini mallarını eksiksiz hep getirdi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 27"},
{"id": "KT-K-1#4", "gunumuzTurkcesi": "Kül Tigin yirmi yedi yaşında (iken) Karluk halkı (serbestçe) hareket eden", "tur": "ceviri", "kaynak": "Tekin 1998, s. 27"},
{"id": "KT-K-1#5", "gunumuzTurkcesi": "(bir) düşman oldu.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 27"},
{"id": "KT-K-1#6", "gunumuzTurkcesi": "(Onlarla) Tamag kutsal tepesinde savaştık.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 27"},

{"id": "KT-KD-1#1", "gunumuzTurkcesi": "Kül Tigin Koyun yılının on yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},
{"id": "KT-KD-1#2", "gunumuzTurkcesi": "(nci günün)de vefat etti. Dokuzuncu ayın yirmi yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},
{"id": "KT-KD-1#3", "gunumuzTurkcesi": "sinde yas törenini tamamladık.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},
{"id": "KT-KD-1#4", "gunumuzTurkcesi": "Türbesini, resimlerini-heykellerini (ve) kitabe taşını Maymun yılının yedinci ayının yirmi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},
{"id": "KT-KD-1#5", "gunumuzTurkcesi": "yedisinde hep bitirdik.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},
{"id": "KT-KD-1#6", "gunumuzTurkcesi": "Kül Tigin kendisi kırk yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},

{"id": "KT-GD-1#1", "gunumuzTurkcesi": "Bunca yazıyı yazan: Kül Tigin'in yeğeni Yolluğ Tigin, (ben), yazdım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},
{"id": "KT-GD-1#2", "gunumuzTurkcesi": "Yirmi gün oturup bu taşa, bu duvara hep Yolluğ Tigin, (ben) yazdım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},
{"id": "KT-GD-1#3", "gunumuzTurkcesi": "(Halkınızı) değerli evladınızdan, tay (gibi) oğullarınızdan daha iyi besliyor", "tur": "ceviri", "kaynak": "Tekin 1998, s. 28"},

{"id": "KT-GB-1#2", "gunumuzTurkcesi": "Yolluğ Tigin (yazıcı).", "tur": "ceviri", "kaynak": "Tekin 1998, s. 8"},

{"id": "KT-B-1#2", "gunumuzTurkcesi": "Kardeşim Kül Tigin ölesiye yitesiye hizmet ettiği için, Türk Bilge Kağan mülküne, kardeşim Kül Tigin'i gözeterek (hükümdar olarak oturdum).", "tur": "ceviri", "kaynak": "Tekin 1998, s. 29"},

{"id": "BK-D-6#1", "gunumuzTurkcesi": "yaratılmamış şüphesiz.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 22", "not": "BK D6, KT D5-6 ile birebir paralel; çeviri Tekin'in KT karşılığından (s. 22) verildi."},
{"id": "BK-D-6#2", "gunumuzTurkcesi": "Oğulları babaları gibi yaratılmamış şüphesiz.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 22"},
{"id": "BK-D-6#3", "gunumuzTurkcesi": "Akılsız kağanlar tahta oturmuş", "tur": "ceviri", "kaynak": "Tekin 1998, s. 22"},
{"id": "BK-D-6#4", "gunumuzTurkcesi": "şüphesiz, kötü kağanlar tahta oturmuş", "tur": "ceviri", "kaynak": "Tekin 1998, s. 22"},
{"id": "BK-D-6#5", "gunumuzTurkcesi": "şüphesiz. Kumandanları da akılsız", "tur": "ceviri", "kaynak": "Tekin 1998, s. 22"},
{"id": "BK-D-6#6", "gunumuzTurkcesi": "imişler şüphesiz.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 22"},

{"id": "BK-G-1#2", "gunumuzTurkcesi": "Otuz sekiz yaşımda kışın Kıtaylara doğru sefer ettim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 40"}
