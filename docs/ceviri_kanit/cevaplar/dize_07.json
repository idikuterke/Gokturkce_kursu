{"cevaplar": [
{"id": "BK-D-31#1", "gunumuzTurkcesi": "olacak idi. (Saflarımızı) yarıp dağıtarak gelen ordusunu (geri) püskürttüm.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 38"},
{"id": "BK-D-31#2", "gunumuzTurkcesi": "(Bu sayede) pek çok ölecek (kişi) hayatta kaldı.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 38"},
{"id": "BK-D-31#3", "gunumuzTurkcesi": "Orada Tongra (boyu) alplerinden", "tur": "ceviri", "kaynak": "Tekin 1998, s. 38"},
{"id": "BK-D-31#4", "gunumuzTurkcesi": "bir grubu Tonga Tigin'in cenaze töreninde çevirip kuşatarak dövdüm.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 38"},
{"id": "BK-D-31#5", "gunumuzTurkcesi": "Dördüncü olarak Ezgenti Kadız'da savaştım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 38"},
{"id": "BK-D-31#6", "gunumuzTurkcesi": "Askerlerini orada mızrakladım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 38"},

{"id": "BK-D-32#1", "gunumuzTurkcesi": "Oğuzlara doğru sefer ettim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#2", "gunumuzTurkcesi": "Birinci ordu (sefere) çıkmış", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#3", "gunumuzTurkcesi": "idi, ikinci ordu yurtta idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#4", "gunumuzTurkcesi": "Üç Oğuz ordusu baskın yaptı.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#5", "gunumuzTurkcesi": "\"(Türklerin) piyadesi bozuldu\"", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#6", "gunumuzTurkcesi": "diyerek (bizi) zaptetmek üzere (üzerimize) geldi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#7", "gunumuzTurkcesi": "Yarı ordusu evimizi barkımızı yağmalamak için gitti.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#8", "gunumuzTurkcesi": "Yarı ordusu da savaşmak için geldi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-32#9", "gunumuzTurkcesi": "Biz az idik.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},

{"id": "BK-D-33#1", "gunumuzTurkcesi": "dağıttım. Tanrı buyurduğu için, ben çalışıp kazandığım için Türk halkı (da) öylece kazanmış", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-33#2", "gunumuzTurkcesi": "(oldu) şüphesiz. Ben erkek kardeşimle beraber bu kadar önderlik edip kazanmasa idim, Türk halkı ölecek idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-33#3", "gunumuzTurkcesi": "Yok olacak idi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-33#4", "gunumuzTurkcesi": "Türk beyleri (ve) halkı, şöylece düşünün.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},

{"id": "BK-D-34#1", "gunumuzTurkcesi": "evini barkını bozdum.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-34#2", "gunumuzTurkcesi": "Oğuz halkı, Dokuz Tatarlarla birlikte toparlanıp geldi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-34#3", "gunumuzTurkcesi": "Ağu'da iki büyük savaş verdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-34#4", "gunumuzTurkcesi": "Askerlerini bozdum, ülkelerini orada zaptettim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},

{"id": "BK-D-35#1", "gunumuzTurkcesi": "besleyip doyurmuş (olan) yiğit kağanına ihanet etti.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-35#3", "gunumuzTurkcesi": "(Bu hareketi) tasvip etmedi hiç şüphesiz. Dokuz Oğuz halkı yerini yurdunu bırakıp Çin'e doğru gitti.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},

{"id": "BK-D-36#2", "gunumuzTurkcesi": "sanı yok oldu.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-36#5", "gunumuzTurkcesi": "Devleti (ve) yasaları daha iyi kazandım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},

{"id": "BK-D-37#1", "gunumuzTurkcesi": "Orada savaştım, askerlerini mızrakladım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-37#2", "gunumuzTurkcesi": "Tabi olanlar tabi oldu, halk oldu.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-37#3", "gunumuzTurkcesi": "Ölenler öldü. Selenga (nehri boyunca) aşağıya", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},
{"id": "BK-D-37#4", "gunumuzTurkcesi": "yürüyüp Karağan geçidinde, evini barkını orada bozdum.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 39"},

{"id": "BK-D-40#2", "gunumuzTurkcesi": "\"Güneyde Karluk halkına doğru sefer et\" diye Tudun Yamtar'ı gönderdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 40"},

{"id": "BK-G-2#2", "gunumuzTurkcesi": "Otuz sekiz yaşımda kışın Kıtaylara doğru sefer ettim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 40"},

{"id": "BK-G-7#1", "gunumuzTurkcesi": "verdim. Yiğit erlerini öldürüp balbal yapıverdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},

{"id": "BK-G-8#1", "gunumuzTurkcesi": "General Ku kumandasında", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-8#2", "gunumuzTurkcesi": "kırk bin (kişilik bir) ordu geldi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-8#3", "gunumuzTurkcesi": "Töngker dağında hücum edip vuruştum.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-8#4", "gunumuzTurkcesi": "Otuz bin askeri öldürdüm.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},

{"id": "BK-G-9#1", "gunumuzTurkcesi": "öldürdü. Büyük oğlum hastalanıp ölünce Ku'yu, Generali, balbal (olarak) dikiverdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-9#2", "gunumuzTurkcesi": "Ben on dokuz yıl şad (olarak) hüküm sürdüm.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-9#3", "gunumuzTurkcesi": "On dokuz yıl (da) kağan (olarak) hüküm sürdüm.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},

{"id": "BK-G-10#1", "gunumuzTurkcesi": "Türklerime (ve) halkıma daha iyi bir şekilde öylece kazanıverdim.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-10#2", "gunumuzTurkcesi": "Bu kadar (çok) kazanıp babam kağan Köpek yılının onuncu ayının altı", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-10#3", "gunumuzTurkcesi": "yirmisinde (26'sında) vefat etti.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-10#4", "gunumuzTurkcesi": "Domuz yılının beşinci ayının yedi", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-10#5", "gunumuzTurkcesi": "yirmisinde (27'sinde) cenaze (törenini) tamamladım.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},

{"id": "BK-G-11#1", "gunumuzTurkcesi": "babası Lisün Tay-Sengün kumandasında", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-11#2", "gunumuzTurkcesi": "beş yüz kişi geldi.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"},
{"id": "BK-G-11#4", "gunumuzTurkcesi": "Gereğinden fazla getirdi; cenaze mumları getirip dikiverdiler.", "tur": "ceviri", "kaynak": "Tekin 1998, s. 41"}
]}
