{
 "cevaplar": [
  {
   "id": "BK-D-29#7",
   "gunumuzTurkcesi": "Mızrakladım, öldürdüm. Dokuz Oğuzlar benim",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 38"
  },
  {
   "id": "BK-D-36#3",
   "gunumuzTurkcesi": "Burada bana kul oldu.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 39"
  },
  {
   "id": "BK-D-38#2",
   "gunumuzTurkcesi": "O at sürüsünü alıp (onları) doyurdum.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-D-38#3",
   "gunumuzTurkcesi": "Otuz dört yaşımda Oğuzlar kaçıp Çin'e gittiler.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-D-39#1",
   "gunumuzTurkcesi": "Tatabı halkı Çin imparatoruna tabi oldu.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-D-39#2",
   "gunumuzTurkcesi": "Elçisi, iyi haberi (ve) ricaları gelmiyor diye yazın sefer ettim.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-D-39#3",
   "gunumuzTurkcesi": "Halkı orada bozguna uğrattım.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-D-41#2",
   "gunumuzTurkcesi": "Onları korkutayım diye sefer ettim.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-D-41#3",
   "gunumuzTurkcesi": "(Kale) muhafızı iki üç kişi ile kaçıp gitti.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-D-41#4",
   "gunumuzTurkcesi": "Avam halkı (ise) \"Kağanım geldi\" diye kıvanıp sevindi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-GD-1#2",
   "gunumuzTurkcesi": "Geceli gündüzlü yedi vakitte susuz (araziyi) geçtim.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-G-1#2",
   "gunumuzTurkcesi": "bin askeri birinci gün öldürdüm.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-G-1#3",
   "gunumuzTurkcesi": "Piyade ordularını ikinci",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-G-1#4",
   "gunumuzTurkcesi": "gün tamamiyle öldürdüm.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 40"
  },
  {
   "id": "BK-B-3#1",
   "gunumuzTurkcesi": "Yaz gelince yukarıda gök",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 42",
   "not": "BK B3-B6 mersiyesinin bütün çevirisi Tekin 2003, s. 177'de de verilidir."
  },
  {
   "id": "BK-B-4#1",
   "gunumuzTurkcesi": "davulu nasıl gümbürderse, öylece;",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 42"
  },
  {
   "id": "BK-B-5#1",
   "gunumuzTurkcesi": "dağlarda geyikler nasıl böğürürse, öylece",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 42"
  },
  {
   "id": "BK-B-6#1",
   "gunumuzTurkcesi": "yas tutuyorum. Babam Kağan(ın)",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 42"
  },
  {
   "id": "BK-GB-1#1",
   "gunumuzTurkcesi": "Bilge Kağan kitabesini (ben) Yolluğ Tigin yazdım.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 42"
  },
  {
   "id": "TY1-G-9#1",
   "gunumuzTurkcesi": "Ordusu üç bin",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 44"
  },
  {
   "id": "TY1-G-9#2",
   "gunumuzTurkcesi": "(kişilik) imiş. Biz iki bin",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 44"
  },
  {
   "id": "TY1-G-9#3",
   "gunumuzTurkcesi": "(kişi) idik. Savaştık. Tanrı buyurdu.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 44"
  },
  {
   "id": "TY1-G-9#4",
   "gunumuzTurkcesi": "(Oğuzları) bozguna uğrattık; ırmağa düştüler.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 44"
  },
  {
   "id": "TY1-G-9#5",
   "gunumuzTurkcesi": "Bozguna uğrayanları da yollarda ölüp kaldılar.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 44"
  },
  {
   "id": "TY1-G-9#6",
   "gunumuzTurkcesi": "Hep (öldüler). Ondan sonra Oğuzların hepsi geldi.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 44"
  },
  {
   "id": "TY1-K-1#1",
   "gunumuzTurkcesi": "arz ettim. Orduyu yürüttüm.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 45"
  },
  {
   "id": "TY1-K-1#4",
   "gunumuzTurkcesi": "(Askerleri) at üzerine bindirip karları söktüm.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-3#1",
   "gunumuzTurkcesi": "Anı ırmağına vardık. O ırmak boyunca",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-3#3",
   "gunumuzTurkcesi": "Atları ağaçlara bağlıyor",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-3#4",
   "gunumuzTurkcesi": "idik. Gece gündüz dört nala gittik.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-3#5",
   "gunumuzTurkcesi": "Kırgızları uykuda iken bastık.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-10#1",
   "gunumuzTurkcesi": "getirdiler: \"Oturun!\" diye demiş.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 46"
  },
  {
   "id": "TY1-K-10#2",
   "gunumuzTurkcesi": "\"Devriyeleri ve gözetleme kulelerini iyi yerleştir.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY1-K-10#3",
   "gunumuzTurkcesi": "Baskına uğratma!\" demiş. Bögü Kağan bana böyle (haber) göndermiş.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY1-K-10#4",
   "gunumuzTurkcesi": "Apa Tarkan'a (ise) gizli mesaj göndermiş:",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY1-K-10#5",
   "gunumuzTurkcesi": "\"Bilge Tonyukuk aksi mizaçlıdır, öfkelidir; yanılır.",
   "tur": "ceviri",
   "kaynak": "Ata 2011, s. 117",
   "not": "Tekin 1998 s. 47 ile ayni ifade; atif, bu cumlecigin kanitinda yer alan Ata 2011 s. 117 ozel aciklamasina dayanir."
  },
  {
   "id": "TY1-K-11#1",
   "gunumuzTurkcesi": "'Ordu sevk edelim' diyecektir. Kabul etmeyin!\" Bu sözleri işitip orduyu yürüttüm.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY1-K-11#2",
   "gunumuzTurkcesi": "Altay dağlarını yolsuz olarak aştık.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY1-K-11#3",
   "gunumuzTurkcesi": "İrtiş ırmağını geçitsiz olarak geçtik.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY1-K-11#4",
   "gunumuzTurkcesi": "Gece akın ettik. Bolçu'ya tan ağarırken vardık.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-6#1",
   "gunumuzTurkcesi": "korkmadık. Savaştık. (Düşmanı) Tarduş Şadına doğru kovalayıp",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-6#2",
   "gunumuzTurkcesi": "dağıttık. Kağanını tuttuk. Yabgusunu, Şadını",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-9#1",
   "gunumuzTurkcesi": "Biz de sefere çıktık.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-B-9#2",
   "gunumuzTurkcesi": "Onları geçtik. İnci (Sır Derya) ırmağını geçerek \"Tanrı Oğlu\" denilen Bengili Ek dağını aşırdım.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 47"
  },
  {
   "id": "TY2-D-3#1",
   "gunumuzTurkcesi": "Gözetleme kulelerini (yerli yerince) yerleştirdim.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 48"
  },
  {
   "id": "TY2-D-3#3",
   "gunumuzTurkcesi": "Kağanımla ordu sevk ettik. Tanrı esirgesin,",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 48"
  },
  {
   "id": "TY2-K-4#1",
   "gunumuzTurkcesi": "Türk Bilge Kağan, Türk Sir halkını, Oğuz halkını besleyerek tahtta oturuyor.",
   "tur": "ceviri",
   "kaynak": "Tekin 1998, s. 49"
  }
 ]
}