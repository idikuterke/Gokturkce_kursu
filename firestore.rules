rules_version = '2';

// Göktürkçe Öğreneği — ilerleme kayıtları.
// Tek kural: herkes yalnızca kendi belgesine erişir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Açıkça izin verilmeyen her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
